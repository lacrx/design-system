{
  "name": "@lacrx/design-system",
  "version": "0.1.0",
  "description": "Cross-project design system: token pipeline, AI agent rules, lint enforcement",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./lint/*": "./lint/*",
    "./build/*": "./build/*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lacrx/design-system.git"
  },
  "bin": {
    "design-system": "./bin/cli.js"
  },
  "scripts": {
    "build": "node build/build.js",
    "validate": "node schema/validate.js"
  },
  "files": [
    "build/",
    "bin/",
    "lint/",
    "schema/",
    "templates/",
    "index.js"
  ],
  "dependencies": {
    "style-dictionary": "^4.2.0"
  },
  "peerDependencies": {
    "stylelint": ">=16.0.0",
    "stylelint-declaration-strict-value": ">=1.10.0"
  },
  "peerDependenciesMeta": {
    "stylelint": { "optional": true },
    "stylelint-declaration-strict-value": { "optional": true }
  }
}
